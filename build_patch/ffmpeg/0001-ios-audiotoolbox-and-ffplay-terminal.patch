 }
 
 /* handle an event sent by the GUI */
+
+static struct termios ffplay_oldtty;
+static int ffplay_tty_active = 0;
+static int ffplay_tty_fd = -1;
+static pthread_t ffplay_kb_tid;
+
+static void ffplay_tty_restore(void) {
+    if (ffplay_tty_active && ffplay_tty_fd >= 0) {
+        tcsetattr(ffplay_tty_fd, TCSANOW, &ffplay_oldtty);
+        ffplay_tty_active = 0;
+    }
+}
+
 static void *ffplay_keyboard_thread(void *arg) {
+    unsigned char ch;
+    int fd = ffplay_tty_fd >= 0 ? ffplay_tty_fd : 0;
+    while (read(fd, &ch, 1) == 1) {
+        if (ch == 'q' || ch == 'Q') {
+            SDL_Event ev;
+            memset(&ev, 0, sizeof(ev));
+            ev.type = SDL_QUIT;
+            SDL_PushEvent(&ev);
+            break;
+        }
+
+        SDL_Event ev;
+        memset(&ev, 0, sizeof(ev));
+        ev.type = SDL_KEYDOWN;
+
+        if (ch == 27) { /* Escape or Arrow sequence */
+            unsigned char seq[2];
+            if (read(fd, &seq[0], 1) == 1 && read(fd, &seq[1], 1) == 1) {
+                if (seq[0] == 91) { /* [ */
+                    switch (seq[1]) {
+                    case 65: ev.key.keysym.sym = SDLK_UP; break;
+                    case 66: ev.key.keysym.sym = SDLK_DOWN; break;
+                    case 67: ev.key.keysym.sym = SDLK_RIGHT; break;
+                    case 68: ev.key.keysym.sym = SDLK_LEFT; break;
+                    default: continue;
+                    }
+                }
+            } else {
+                ev.type = SDL_QUIT;
+                SDL_PushEvent(&ev);
+                break;
+            }
+        } else if (ch == ' ' || ch == 'p' || ch == 'P') {
+            ev.key.keysym.sym = SDLK_SPACE;
+        } else if (ch == 'm' || ch == 'M') {
+            ev.key.keysym.sym = SDLK_m;
+        } else if (ch == '0' || ch == '+') {
+            ev.key.keysym.sym = SDLK_0;
+        } else if (ch == '9' || ch == '-') {
+            ev.key.keysym.sym = SDLK_9;
+        } else {
+            ev.key.keysym.sym = ch;
+        }
+
+        SDL_PushEvent(&ev);
+    }
+    return NULL;
+}
+
+static void ffplay_tty_init(void) {
+    ffplay_tty_fd = open("/dev/tty", O_RDWR);
+    if (ffplay_tty_fd < 0)
+        ffplay_tty_fd = 0;
+
+    if (isatty(ffplay_tty_fd)) {
+        struct termios tty;
+        if (tcgetattr(ffplay_tty_fd, &tty) == 0) {
+            ffplay_oldtty = tty;
+            ffplay_tty_active = 1;
+            atexit(ffplay_tty_restore);
+
+            tty.c_lflag &= ~(ECHO | ICANON);
+            tty.c_cc[VMIN] = 1;
+            tty.c_cc[VTIME] = 0;
+            tcsetattr(ffplay_tty_fd, TCSANOW, &tty);
+
+            pthread_create(&ffplay_kb_tid, NULL, ffplay_keyboard_thread, NULL);
+        }
+    }
+}
