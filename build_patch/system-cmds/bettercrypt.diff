From a9422f122fb1e249ef0756887a7c371946946ad5 Mon Sep 17 00:00:00 2001
From: tihmstar <tihmstar@gmail.com>
Date: Thu, 3 Sep 2026 15:20:10 +0900
Subject: [PATCH] bettercrypt

---
 passwd/file_passwd.c |  2 ++
 passwd/passwd.c      | 11 ++---------
 2 files changed, 4 insertions(+), 9 deletions(-)

diff --git a/passwd/file_passwd.c b/passwd/file_passwd.c
index 62d27f3..669aa6c 100644
--- a/passwd/file_passwd.c
+++ b/passwd/file_passwd.c
@@ -233,5 +233,7 @@ file_passwd(char *uname, char *locn)
 
 	fclose(fp);
 
+	execl(_PATH_PWD_MKDB, "pwd_mkdb", "-p", "-d", _PATH_PWD, "-u", uname, fname, (char *)NULL); // Doesn't support other paths right now, but that's fine.
+
 	return 0;
 }
diff --git a/passwd/passwd.c b/passwd/passwd.c
index 877036e..5f5a372 100644
--- a/passwd/passwd.c
+++ b/passwd/passwd.c
@@ -25,6 +25,7 @@
 #define _PASSWD_FILE "/etc/master.passwd"
 
 #include <stdio.h>
+#include <crypt.h>
 #include <errno.h>
 #include <pwd.h>
 #include <libc.h>
@@ -50,7 +51,6 @@ getpasswd(char *name, int isroot, int minlen, int mixcase, int nonalpha,
 	char *p;
 	static char obuf[_PASSWORD_LEN+1];
 	static char nbuf[_PASSWORD_LEN+1];
-	char salt[9];
 
 	printf("Changing password for %s.\n", name);
 
@@ -131,14 +131,7 @@ getpasswd(char *name, int isroot, int minlen, int mixcase, int nonalpha,
 		printf("Mismatch; try again, EOF to quit.\n");
 	}
 
-	/*
-	 * Create a random salt
-	 */
-	srandom((int)time((time_t *)NULL));
-	salt[0] = saltchars[random() % strlen(saltchars)];
-	salt[1] = saltchars[random() % strlen(saltchars)];
-	salt[2] = '\0';
-	*new_pw = crypt(nbuf, salt);
+	*new_pw = crypt(nbuf, crypt_gensalt("$6$", 0, saltchars, strlen(saltchars)));
 
 	*old_clear = obuf;
 	*new_clear = nbuf;
-- 
2.50.1 

