From 482ceca337331e211fb687dc7f517d9c876d140a Mon Sep 17 00:00:00 2001
From: tihmstar <tihmstar@gmail.com>
Date: Thu, 3 Sep 2026 15:06:59 +0900
Subject: [PATCH] system_cmds: shutdown may not work

---
 shutdown/shutdown.c | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/shutdown/shutdown.c b/shutdown/shutdown.c
index beeee91..d17c39e 100644
--- a/shutdown/shutdown.c
+++ b/shutdown/shutdown.c
@@ -71,8 +71,10 @@ __FBSDID("$FreeBSD$");
 #include <vproc.h>
 #include <vproc_priv.h>
 
+#if defined(__APPLE__) && !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR)
 #include "kextmanager.h"
 #include <IOKit/kext/kextmanager_types.h>
+#endif
 #include <IOKit/pwr_mgt/IOPMLib.h>
 #include <mach/mach_port.h>		// allocate
 #include <mach/mach.h>			// task_self, etc
@@ -84,6 +86,8 @@ __FBSDID("$FreeBSD$");
 #include "pathnames.h"
 #endif /* __APPLE__ */
 
+int	reboot3(int);
+
 #ifdef DEBUG
 #undef _PATH_NOLOGIN
 #define	_PATH_NOLOGIN	"./nologin"
@@ -136,8 +140,8 @@ static void nolog(void);
 static void timeout(int);
 static void timewarn(time_t);
 static void usage(const char *);
-#ifdef __APPLE__
 static int audit_shutdown(int);
+#if defined(__APPLE__) && !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR)
 static int reserve_reboot(void);
 #endif
 
@@ -454,13 +458,13 @@ log_and_exec_reboot_or_halt(void)
 die_you_gravy_sucking_pig_dog(void)
 #endif
 {
-#ifndef __APPLE__
-	char *empty_environ[] = { NULL };
-#else
+#if defined(__APPLE__) && !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR)
 	if ((errno = reserve_reboot())) {
 		warn("couldn't lock for reboot");
 		finish(0);
 	}
+#else
+	char *empty_environ[] = { NULL };
 #endif
 
 #ifdef __APPLE__
@@ -739,7 +743,6 @@ usage(const char *cp)
 	exit(1);
 }
 
-#ifdef __APPLE__
 /*
  * The following tokens are included in the audit record for shutdown
  * header
@@ -790,7 +793,7 @@ audit_shutdown(int exitstatus)
 	return 1;
 }
 
-
+#if 0
 static bool
 kextdDisabled(void)
 {
-- 
2.50.1

